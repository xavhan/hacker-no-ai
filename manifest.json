{
  "manifest_version": 3,
  "name": "Hacker No AI",
  "version": "1.0",
  "description": "Hide or dim AI-related stories on Hacker News.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://news.ycombinator.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
